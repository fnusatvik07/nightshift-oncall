# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and you are done. The defaults match the containers
# in platform/docker-compose.yml, so nothing here needs changing unless a port
# is already taken on your machine.
#
#     cp .env.example .env
#
# .env is git ignored. Never commit it, and never put a real API key in the
# example file.
#
# One thing worth understanding, because it is the reason the same code runs on
# your laptop and inside the Airflow container: pipelines/lib/config.py loads
# this file with override=False, which means a variable already set in the
# environment WINS. The compose file sets POSTGRES_HOST=postgres inside the
# container, so the pipelines find the database there, and not one line of
# pipeline code changes between the two.
# ═══════════════════════════════════════════════════════════════════════════

# ── the app database, and the processor's ledger, on one Postgres ──────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=kerb
POSTGRES_USER=kerb
POSTGRES_PASSWORD=kerb_local_dev

# ── the driver app's documents ────────────────────────────────────────────
MONGO_USER=kerb
MONGO_PASSWORD=kerb_local_dev
MONGO_PORT=27019
MONGO_URI=mongodb://kerb:kerb_local_dev@localhost:27019/kerb_app?authSource=admin

# ── the event stream ──────────────────────────────────────────────────────
REDPANDA_PORT=19092
REDPANDA_ADMIN_PORT=19644
REDPANDA_BROKERS=localhost:19092

# ── object storage ────────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=kerbadmin
MINIO_SECRET_KEY=kerb_local_dev

# ── the payment processor ─────────────────────────────────────────────────
PARTNER_API_PORT=8088
PARTNER_API=http://localhost:8088
# what share of settlements come back with an unreadable status. Notebook 5
# is about what to do with those. Set it to 0 for a run with nothing held.
PN_EMPTY_STATUS_SHARE=0.34

# ── the orchestrator ──────────────────────────────────────────────────────
AIRFLOW_PORT=8080
AIRFLOW_USER=kerb
AIRFLOW_PASSWORD=kerb_local_dev

# ── the browser GUIs ──────────────────────────────────────────────────────
PGWEB_PORT=8081
MONGO_EXPRESS_PORT=8082
REDPANDA_CONSOLE_PORT=8083

# ── how much data to generate ─────────────────────────────────────────────
# 30 days of 12,000 rides is about 360,000 trips and takes a few minutes.
# `python -m seed --quick` ignores these and generates 7 days of 2,000.
KERB_SEED=20260901
KERB_DAYS=30
KERB_TRIPS_PER_DAY=12000

# ── the two services in this project ──────────────────────────────────────
SIGNAL_API_PORT=8091
AGENT_PORT=8092
SIGNAL_INTERVAL=60
SIGNAL_SERVICE_URL=http://localhost:8091
AGENT_SERVICE_URL=http://localhost:8092

# ── the model the agents use ──────────────────────────────────────────────
# Any provider LangChain supports, as "provider:model".
OPENAI_API_KEY=
ONCALL_MODEL=openai:gpt-5.4-mini
# the supervisor can be a stronger model than the specialists. Defaults to the same.
ONCALL_SUPERVISOR_MODEL=

# ── Confluence, for the incident pages ────────────────────────────────────
# Leave these empty and the agent writes markdown into artifacts/ instead, so
# the whole project still runs with no Atlassian account at all.
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
ATLASSIAN_TOKEN=
CONFLUENCE_SPACE=
CONFLUENCE_PARENT=NIGHTSHIFT on call

# ── how hard the agent service works ──────────────────────────────────────
ONCALL_MAX_CONCURRENT=2
ONCALL_QUEUE_LIMIT=50

# Which repository proposed code changes are raised against. Defaults to this
# project. In a real estate the pipelines live in their own repo with their own
# reviewers, so point this at a local clone of that one.
ONCALL_REPO_PATH=
