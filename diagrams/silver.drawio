<mxfile host="app" agent="nightshift"><diagram name="s1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2530" pageHeight="990" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Five tables in. One row per ride out." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="2350" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Silver is where the sources stop being separate." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="2350" height="34" as="geometry"/></mxCell><mxCell id="n4" value="BRONZE   ·   five faithful copies, each shaped like its source" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;bronze_trips&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one row per ride&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;bronze_events&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;five rows per ride&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;bronze_driver_app&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;the surge&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;bronze_settlements&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;the money&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n9" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;bronze_zones&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;the zone names&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n10" value="SILVER   ·   the first table anybody outside the team would recognise" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="400" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;silver_rides&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one row per ride, with the fare, the surge, the money and the&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;zone name attached. Seconds turned into minutes. No rider_id.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="484" width="2290" height="152" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Three things silver is allowed to do that bronze was not:&lt;/b&gt; convert units, invent columns that existed in no single source, and drop a personal identifier nothing downstream uses. Carrying a rider id you do not need is a liability, not an asset." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="650" width="2290" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="s2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="940" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="The most expensive word in data engineering" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="940" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Change one LEFT to INNER and nothing goes wrong. The number is just smaller." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="940" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;LEFT JOIN   ·   keep the ride&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;cancelled ride, no completed event   kept&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;no driver app record                 kept&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;settlement is T+2, not there yet     kept&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;0.4% never resolved to a zone        kept&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;84,027 rides&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="248" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#B91C1C&apos;&gt;INNER JOIN  ·  drop the ride&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;cancelled ride, no completed event   GONE&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;no driver app record                 GONE&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;settlement is T+2, not there yet     GONE&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;0.4% never resolved to a zone        GONE&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;74,743 rides. 9,284 disappeared.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="248" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Picture how that presents itself in production.&lt;/b&gt;&lt;br&gt;&lt;br&gt;No error. No failed run. No log line. Somebody changes a join to make a query faster, the ride count drops four percent, and it takes three weeks to notice and a day to find.&lt;br&gt;&lt;br&gt;&lt;b&gt;A wrong answer that runs successfully is worse than a crash, because a crash tells you.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="500" width="880" height="212" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="s3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="ON, or WHERE. It is not a style choice." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="940" height="46" as="geometry"/></mxCell><mxCell id="n3" value="The same condition in the wrong clause turns a LEFT JOIN back into an INNER one." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="940" height="34" as="geometry"/></mxCell><mxCell id="n4" value="LEFT&amp;nbsp;JOIN&amp;nbsp;bronze_events&amp;nbsp;e&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;&amp;nbsp;e.trip_id&amp;nbsp;=&amp;nbsp;t.trip_id&lt;br&gt;&amp;nbsp;&amp;nbsp;AND&amp;nbsp;e.event&amp;nbsp;=&amp;nbsp;&apos;completed&apos;&lt;br&gt;&lt;br&gt;--&amp;nbsp;correct" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Courier New;fontSize=18;fontColor=#E2E8F0;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="880" height="190" as="geometry"/></mxCell><mxCell id="n5" value="LEFT&amp;nbsp;JOIN&amp;nbsp;bronze_events&amp;nbsp;e&lt;br&gt;&amp;nbsp;&amp;nbsp;ON&amp;nbsp;&amp;nbsp;e.trip_id&amp;nbsp;=&amp;nbsp;t.trip_id&lt;br&gt;WHERE&amp;nbsp;e.event&amp;nbsp;=&amp;nbsp;&apos;completed&apos;&lt;br&gt;&lt;br&gt;--&amp;nbsp;an&amp;nbsp;inner&amp;nbsp;join&amp;nbsp;wearing&amp;nbsp;a&amp;nbsp;disguise" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Courier New;fontSize=18;fontColor=#E2E8F0;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="880" height="190" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;The WHERE runs after the join.&lt;/b&gt; The LEFT JOIN carefully kept the rides with no completed event, giving them NULL, and then &lt;code&gt;WHERE e.event = &apos;completed&apos;&lt;/code&gt; throws every one of those NULL rows away.&lt;br&gt;&lt;br&gt;Same rows lost as an INNER JOIN, with a LEFT JOIN sitting in the query looking reassuring." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="880" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>