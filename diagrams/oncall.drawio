<mxfile host="app" agent="nightshift"><diagram name="o1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Two services, and one record between them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Band four of the architecture. Everything above this has already happened." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="THE WAREHOUSE  ·  the only thing either service ever reads" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;THE SIGNAL BOARD&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Runs on a clock.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;13 queries, one number each.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Emits a record when one breaches.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Knows nothing about agents.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="880" height="236" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;THE AGENT SYSTEM&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Asleep until a record arrives.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Diagnoses, proposes, verifies.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Changes nothing.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Knows nothing about KPIs.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="880" height="236" as="geometry"/></mxCell><mxCell id="n7" value="one record" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Neither service imports the other.&lt;/b&gt; They share one pydantic model, in a package that neither of them owns, and they talk over HTTP. That is what lets you restart either one mid sentence, deploy them separately, and rewrite one of them next year without touching the other.&lt;br&gt;&lt;br&gt;&lt;b&gt;The record is written to the database BEFORE the doorbell is rung.&lt;/b&gt; A failed notification then costs latency, not an incident." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="1820" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="o2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A KPI is not a signal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="940" height="46" as="geometry"/></mxCell><mxCell id="n3" value="The distinction the whole service rests on." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="940" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;A KPI&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A number with a definition&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and an owner.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&quot;revenue yesterday&quot;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;It is never wrong.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;It cannot fire.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="292" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;A SIGNAL&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A KPI, plus a baseline,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;plus a tolerance.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&quot;revenue yesterday, which is&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;normally 1.9 million&quot;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;This one can breach.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="292" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;You cannot alert on a KPI&lt;/b&gt;, because a number on its own has no opinion about itself. You can only alert once somebody has written down what normal looks like, and that sentence is the part nobody wants to write.&lt;br&gt;&lt;br&gt;Two kinds of baseline. &lt;b&gt;Computed from history&lt;/b&gt; for things that vary, like rides per day. &lt;b&gt;Decided by a person&lt;/b&gt; for things that should not vary at all: zero held records is not an average, it is a rule." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="880" height="242" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="o3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2530" pageHeight="840" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="The five agents, and why five" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="2350" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Each answers one question. None of them can do another&apos;s job." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="2350" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;1 TRIAGE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Is this real?&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;reads the board only&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;2 DATA&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;What is wrong?&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;queries, cannot read code&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;3 LINEAGE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Where from?&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;reads code, cannot query&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;4 REMEDIATION&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;What is the fix?&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;writes artifacts only&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;5 VERIFIER&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Did it work?&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;reads the number again&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;An agent with every tool will use every tool.&lt;/b&gt; The data detective cannot open a file, so it cannot guess from the code and call it evidence. The lineage detective cannot query the warehouse, so it cannot re-do the previous agent&apos;s work with worse tools.&lt;br&gt;&lt;br&gt;&lt;b&gt;Narrow the toolbox and the method emerges from the constraint&lt;/b&gt;, rather than from a longer prompt. And every one returns a typed verdict, because a supervisor cannot branch on a paragraph." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="2290" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="o4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="What it is allowed to produce" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="It proposes. A person decides. Nothing it does changes a number." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;A PAGE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Always. Even when it&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;found nothing.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The diagnosis, the evidence,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and what to do.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;A TICKET&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;So it is somebody&apos;s,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;with a severity&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and an owner.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;A PULL REQUEST&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;For a code fix.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A branch and a commit.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Never a merge.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The review IS the gate.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;AN APPROVAL REQUEST&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;For anything touching data.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The graph STOPS here&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and waits for a person.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Nothing is executed.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Whether an agent meant well is a judgement. Whether it CAN write is a fact.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The warehouse connection is opened read only, so Postgres itself refuses a write no matter what the model asked for. Code changes are limited to two directories, because an agent that can edit the tests which judge it is not being judged. Every rule you enforce only in a prompt is a rule you are hoping about." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="1820" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>