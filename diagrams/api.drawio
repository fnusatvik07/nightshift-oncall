<mxfile host="app" agent="nightshift"><diagram name="a1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="880" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Three outcomes, not two" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1410" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Every reference you ask a partner about ends up in exactly one of these." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1410" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;WRITTEN&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;They answered, and we&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;understood the answer.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A row lands.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;HELD&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;They answered, and we did&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;not understand the answer.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Quarantine, with the reason.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;ABSENT&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;They did not answer at all.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Correct. Expected. Healthy.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;The third one is where people go wrong.&lt;/b&gt; A charge still in flight is simply not in the response. It is not an error and it is not a null: it is missing, and missing is the right state for money that has not moved yet.&lt;br&gt;&lt;br&gt;Treat absent as a failure and you page somebody every night for a system behaving exactly as designed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="470" width="1350" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="a2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Ask in batches, and pick the size on purpose" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1410" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Sixty thousand payments. The batch size is a decision, not a detail." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1410" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;BATCH = 1&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;60,000 round trips against&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;a partner&apos;s system.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;An accidental denial of service&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;on a company you have a&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;contract with.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="264" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;BATCH = 250&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;240 calls.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Small enough to finish,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;small enough that a failure&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;costs you 250 records.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;BATCH = 5000&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;12 calls.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Each one long enough to hit&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;a timeout, and a failure&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;costs you the whole batch.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;The number is a trade between round trips and blast radius&lt;/b&gt;, so it belongs in a named constant where it can be argued about, not buried in a loop.&lt;br&gt;&lt;br&gt;And the timeout is not optional. Without one, a partner that hangs takes your pipeline with it, forever, silently." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="1350" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>