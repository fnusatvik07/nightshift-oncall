<mxfile host="app" agent="nightshift"><diagram name="1 Why a pipeline exists"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1380" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Why a pipeline exists at all" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="One database is built to serve customers. Another is built to answer questions. A pipeline is the thing that copies between them." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="THE PROBLEM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;The app database&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Built to serve a rider booking a car.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Fast, small, keeps only recent data.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="880" height="152" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;The finance question&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;How much did we earn last month,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;broken down by zone?&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="880" height="152" as="geometry"/></mxCell><mxCell id="n7" value="WHY YOU CANNOT JUST ASK THE APP DATABASE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;You compete with riders&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Your query reads millions of rows.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;That is capacity the app needed.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="614" width="410" height="152" as="geometry"/></mxCell><mxCell id="n9" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;The history is not there&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Operational databases are trimmed&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;to stay fast. Last year is gone.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="614" width="410" height="152" as="geometry"/></mxCell><mxCell id="n10" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;The shape is wrong&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Arranged for &apos;this one ride&apos;,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;not for &apos;total by day&apos;.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="614" width="410" height="152" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;So: make a copy&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Somewhere else, arranged for&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;questions. That copy is the job.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="614" width="410" height="152" as="geometry"/></mxCell><mxCell id="n12" value="WHAT MAKES IT A PIPELINE AND NOT A SCRIPT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="910" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n13" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;Four things, every time&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;1  it records that it ran&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;2  it holds what it cannot read&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;3  it writes all or nothing&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;4  running it twice is safe&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;anyone can copy rows once · these four are what survive running hourly, forever&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="994" width="880" height="248" as="geometry"/></mxCell><mxCell id="n14" value="Miss any one of them and you have a script that works until the first bad night. The rest of this session is those four ideas, applied to four different kinds of source." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1030" y="994" width="880" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 The four sources"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1440" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Four sources, four different problems" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="This is why there are four pipelines and not one." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="WHAT WE READ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#111111&apos;&gt;PostgreSQL&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;kerb.trips&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;a normal table&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="158" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#111111&apos;&gt;Kafka&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;kerb.trips.lifecycle&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;a stream of events&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="158" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#111111&apos;&gt;MongoDB&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;driver_app_events&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;documents from a phone&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="158" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#111111&apos;&gt;PayNimbus&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;REST API&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;another company&apos;s system&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1500" y="234" width="410" height="158" as="geometry"/></mxCell><mxCell id="n9" value="WHAT IS HARD ABOUT EACH ONE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="550" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n10" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;Nothing&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;It has a shape and a WHERE clause.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Start here.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="634" width="410" height="152" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;No WHERE clause&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;You cannot ask for yesterday.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Only &apos;since I last stopped&apos;.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="634" width="410" height="152" as="geometry"/></mxCell><mxCell id="n12" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;No fixed shape&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A mobile release can rename&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;a field on a Tuesday.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="634" width="410" height="152" as="geometry"/></mxCell><mxCell id="n13" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;Not yours&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Slow, changeable, and it will&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;not ask your permission.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="634" width="410" height="152" as="geometry"/></mxCell><mxCell id="n14" value="SO EACH ONE NEEDS SOMETHING DIFFERENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="950" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n15" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A window&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Rebuild a range of days,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;never the whole table.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="1034" width="410" height="152" as="geometry"/></mxCell><mxCell id="n16" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;An offset&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Remember your position,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and commit it after the write.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="1034" width="410" height="152" as="geometry"/></mxCell><mxCell id="n17" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A contract&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Write down every field path&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;you are willing to read.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="1034" width="410" height="152" as="geometry"/></mxCell><mxCell id="n18" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;Batching&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;250 per request, and treat&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&apos;absent&apos; as normal.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="1034" width="410" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 One pipeline, inside"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="1320" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="What happens inside one run" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1410" height="46" as="geometry"/></mxCell><mxCell id="n3" value="The same six steps whether the source is a table, a stream, a document store or an API." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1410" height="34" as="geometry"/></mxCell><mxCell id="n4" value="EVERY RUN, IN THIS ORDER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1410" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;1  Claim the run&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Write a row saying you started.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A job that hangs still leaves evidence.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;2  Read the window&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Only what is new. Never the&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;whole table, ever.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="152" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;3  Check each record&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Is every value one we already&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;know how to read?&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="152" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="THEN ONE OF TWO THINGS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="1410" height="56" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;Understood&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Goes to the target table.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="594" width="410" height="124" as="geometry"/></mxCell><mxCell id="n12" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;Not understood&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Goes to quarantine, with the&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;reason and the original record.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="594" width="410" height="152" as="geometry"/></mxCell><mxCell id="n13" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;Never a third option&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Not dropped. Not defaulted to zero.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Both of those are lies.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="594" width="410" height="152" as="geometry"/></mxCell><mxCell id="n14" value="AND FINALLY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="870" width="1410" height="56" as="geometry"/></mxCell><mxCell id="n15" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;4  Write in one transaction&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Delete the window, insert the new rows,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;commit once. A crash undoes both.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="954" width="880" height="152" as="geometry"/></mxCell><mxCell id="n16" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;5  Close the run&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Status, rows in, rows out.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;So &apos;did it run&apos; has an answer.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="954" width="410" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 The signal board"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1440" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="The signal board, and where it sits" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Five pipelines ran overnight. How do you know the numbers are true?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="A SIGNAL IS FOUR THINGS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A name&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;so people can talk about it&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A query&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;that returns one number&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A baseline&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;what it normally is&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;An owner&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;who gets told&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n9" value="START FROM HOW THINGS BREAK, NOT FROM METRICS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="550" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n10" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#B91C1C&apos;&gt;Six ways it breaks&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;a job did not run&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;a contract held rows&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;a feed stopped arriving&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;the stream got replayed&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;a join dropped rows&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;a field got renamed&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="634" width="880" height="274" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;Six numbers that catch it&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;pipelines_failing&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;records_held&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;rides_per_day&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;events_per_ride&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;rides_missing_fare&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;surge_missing_pct&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1030" y="634" width="880" height="274" as="geometry"/></mxCell><mxCell id="n12" value="WHERE EACH CHECK SITS, AND WHAT IT CAN STOP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="950" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n13" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;A contract&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Inside the pipeline, every record.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;CAN stop a record.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="1034" width="410" height="152" as="geometry"/></mxCell><mxCell id="n14" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;A test&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Inside, before the commit.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;CAN roll back a batch.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="1034" width="410" height="152" as="geometry"/></mxCell><mxCell id="n15" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;A signal&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Outside, afterwards, on a clock.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Can stop NOTHING.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="1034" width="410" height="152" as="geometry"/></mxCell><mxCell id="n16" value="That last one is the point. The board has no power over your data, which is exactly what lets it watch everything without being able to break anything." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1500" y="1034" width="880" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>