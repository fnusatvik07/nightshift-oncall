<mxfile host="app" agent="nightshift"><diagram name="g1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Three checkpoints, and they are not the same thing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1410" height="46" as="geometry"/></mxCell><mxCell id="n3" value="People collapse these into one word, quality, and then argue past each other." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1410" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;THE CONTRACT&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;WHERE  inside the pipeline&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;WHEN   per record, on the way in&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;CAN IT BLOCK?  yes, that is its job&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;An unreadable value is held&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;before it is ever published.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="264" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;THE TESTS&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;WHERE  inside the transaction&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;WHEN   after the write, before the commit&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;CAN IT BLOCK?  yes, it rolls back&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The whole batch, judged at once,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;before anyone can read it.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="292" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;THE SIGNAL BOARD&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;WHERE  outside everything&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;WHEN   on a clock, after the run&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;CAN IT BLOCK?  no. Nothing. Ever.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;It notices that a number moved&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and says whose it is.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="264" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;A check that can block a write is a contract.&lt;/b&gt; A check that cannot is a signal. Calling both of them monitoring is how a team ends up with alerts nobody reads and pipelines that fail for reasons nobody wanted them to." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="1350" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="g2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="840" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A signal is four things" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="There is no model here and no intelligence." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A NAME&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;so a person can&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;talk about it&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A QUERY&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;that returns exactly&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one number&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;A BASELINE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;what that number&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;normally is&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;AN OWNER&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;who gets told&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;when it moves&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Deciding that 34% is far from 0.09% is arithmetic.&lt;/b&gt; Pretending otherwise is how people end up buying something they could have written in an afternoon.&lt;br&gt;&lt;br&gt;The owner is the field that makes the difference between an alert and a fix. A breach with no name attached is a number on a screen that everybody assumes somebody else is looking at." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="1820" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="g3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Two kinds of baseline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="940" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Some numbers have a history. Some have a rule." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="940" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;COMPUTED FROM HISTORY&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;rides_per_day&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;mean of the days before&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;spread from those same days&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;breach when it is 4 spreads out&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;a quiet Tuesday is not a breach. A feed that stopped is.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="278" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;DECIDED BY A PERSON&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;records_held&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;pipelines_failing&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;expected value: 0&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;no history involved&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;zero held records is not an average, it is a rule&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="278" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;And one that needs both.&lt;/b&gt; events_per_ride has a fixed baseline of 4.7 with a tolerance of 1.0, because a completed ride emits five events and a cancelled one emits three. The true average sits a little under five, and that is correct, not a fault. Set the baseline to exactly 5 and the board cries wolf on day one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="880" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>