<mxfile host="app" agent="nightshift"><diagram name="k1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="570" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A producer, a topic, a consumer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Three words. That is the whole shape of Kafka." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;PRODUCER&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Anything that sends events.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The KERB app. You, in a minute.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;THE BROKER&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A program that holds events,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;in order, for a while.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="880" height="152" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;CONSUMER&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Anything that reads them.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Our pipeline. And four other teams.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n7" value="produce" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="k2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="840" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A topic is split into partitions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="So that more than one reader can work at the same time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="TOPIC  kerb.trips.lifecycle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;partition 0&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 0&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 1&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 2&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;...&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;messages arrive in order, and stay in order&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="248" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;partition 1&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 0&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 1&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 2&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;...&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="214" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;partition 2&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 0&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 1&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;offset 2&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;...&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="214" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Order is only guaranteed inside one partition.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Across partitions there is no order at all. That is why a message carries a &lt;b&gt;key&lt;/b&gt;: the same key always goes to the same partition, so all five events of one ride stay in the order they happened." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1500" y="234" width="880" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="k3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="880" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A consumer group is a bookmark" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Reading does not remove anything. So the reader has to remember where it got to." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="THE SAME TOPIC, READ BY TWO DIFFERENT TEAMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;teach-bronze-events&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;position  396,937&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;still to read     2&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;our pipeline&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="880" height="188" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;fraud-service&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;position  120,004&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;still to read 276,935&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;somebody else&apos;s, three days behind&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="880" height="188" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Two bookmarks, stored on the broker, under two names.&lt;/b&gt; Neither can affect the other. The fraud team could be a week behind and our pipeline would never notice.&lt;br&gt;&lt;br&gt;This is also why &lt;code&gt;reset&lt;/code&gt; has to delete the group: our bookmark lives on the broker, not in our database." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="470" width="1820" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="k4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="The order of the last three lines" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Read a batch. Write it. Only then say you have read it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="TWO POSSIBLE ORDERS. ONLY ONE OF THEM IS SAFE." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;WRITE, THEN COMMIT  ·  what we do&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;1  read 5,000 messages&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;2  write them to postgres&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;3  CRASH&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;4  offset never moved&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;next run reads the same 5,000 again. The primary key refuses the duplicates. Nothing is lost.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="880" height="248" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#B91C1C&apos;&gt;COMMIT, THEN WRITE  ·  what the default does&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;1  read 5,000 messages&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;2  offset moves&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;3  CRASH&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;4  rows never written&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;those 5,000 are gone. No error, no gap, nothing to detect. Nobody will ever know.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="880" height="248" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Duplicates you can remove. Missing data you cannot invent.&lt;/b&gt;&lt;br&gt;&lt;br&gt;That is the trade, and it is not close. Reading a message more than once is called &lt;b&gt;at-least-once&lt;/b&gt; delivery, and it is what almost every real streaming pipeline chooses. It only works because the table has a primary key that makes the second copy a no-op." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="1820" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>