<mxfile host="app" agent="nightshift"><diagram name="a1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A for loop, and an orchestrator" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Both run the same eight commands. Only one of them can answer a question at 3am." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="WHAT WE HAVE BEEN DOING:  for name in ORDER: run(name)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="1880" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#B91C1C&apos;&gt;one process, one line&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;p1  ok&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;p2  ok&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;p3  FAILED&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;p4  never started&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;p5  never started&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;...&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;p8  never started&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;one failure stops everything behind it, including the six that share nothing with it&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="880" height="338" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;The five questions a loop cannot answer&lt;/b&gt;&lt;br&gt;&lt;br&gt;The third one failed at 3am. Did the rest still run?&lt;br&gt;Can I retry just that one?&lt;br&gt;Six of these are independent. Why are they queued?&lt;br&gt;Yesterday&apos;s file was late. Can I rerun yesterday alone?&lt;br&gt;Who was told, and about which task?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="880" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="a2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1020" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A DAG is a picture of what must happen before what" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="2820" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Airflow derives the whole thing from two lines: bronze &gt;&gt; silver &gt;&gt; gold." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="2820" height="34" as="geometry"/></mxCell><mxCell id="n4" value="SIX TASKS THAT SHARE NOTHING, SO ALL SIX RUN AT ONCE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="2820" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;p1&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;postgres&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;p2&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;kafka&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;p3&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;mongodb&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;p4&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;rest api&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n9" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;p5&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;minio&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n10" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;p6&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;zones&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="2440" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n11" value="AND ONLY WHEN ALL SIX HAVE FINISHED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="410" width="2820" height="56" as="geometry"/></mxCell><mxCell id="n12" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;p7_silver_rides&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;joins all six together&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one row per ride&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="494" width="1350" height="152" as="geometry"/></mxCell><mxCell id="n13" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;p8_gold_daily&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;waits for silver&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one row per day&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="494" width="1350" height="152" as="geometry"/></mxCell><mxCell id="n14" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Gold cannot be built from a silver table that failed to refresh.&lt;/b&gt; Not should not. Cannot. If silver fails, Airflow does not start gold, and there is no code path where it happens. That one property is why people put up with running Airflow at all." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="670" width="2760" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="a3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="What a task actually is" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Not a copy of the pipeline. The same command a human would type." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;AIRFLOW&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Decides when.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Decides in what order.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Records what happened.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Never touches a row.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n5" value="BashOperator(&lt;br&gt;&amp;nbsp;&amp;nbsp;task_id=&apos;p2_bronze_events&apos;,&lt;br&gt;&amp;nbsp;&amp;nbsp;bash_command=&apos;python&amp;nbsp;-m&amp;nbsp;&apos;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&apos;pipelines.p2_bronze_events&apos;,&lt;br&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Courier New;fontSize=18;fontColor=#E2E8F0;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="880" height="190" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;THE PIPELINE FILE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Has no idea Airflow exists.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Runs the same on your laptop.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Two things follow from that one line.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Any Airflow failure reproduces on your laptop by typing one command. There is no &lt;i&gt;it only breaks in Airflow&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Swap Airflow for something else tomorrow and not one pipeline file changes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="1820" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="a4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="960" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Two files, and where each one lives" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="940" height="46" as="geometry"/></mxCell><mxCell id="n3" value="This is the bit that confuses everybody. It is worth thirty seconds." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="940" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#1D4ED8&apos;&gt;THE WORK&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;pipelines/heartbeat.py&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;python -m pipelines.heartbeat&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;It has never heard of Airflow.&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;you can run this yourself, right now, with no scheduler involved&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="278" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;WHEN TO RUN IT&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;airflow/dags/teach_dag.py&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;schedule=&quot;*/1 * * * *&quot;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;It moves no data and touches no row.&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;Airflow watches this folder, and nothing else&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="278" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Both folders are inside this one repo&lt;/b&gt;, and both are mounted into the Airflow container, which sees them at &lt;code&gt;/opt/kerb/teach&lt;/code&gt; and &lt;code&gt;/opt/airflow/dags&lt;/code&gt;. Same files, different names.&lt;br&gt;&lt;br&gt;So saving a file in &lt;code&gt;airflow/dags/&lt;/code&gt; &lt;b&gt;is&lt;/b&gt; deploying it. There is no build step and nothing to copy anywhere." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="880" height="212" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>