<mxfile host="app" agent="nightshift"><diagram name="b1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Bronze is a copy with no opinions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="The only job is to get the source into our database, faithfully, fast." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#111111&apos;&gt;kerb.trips&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Somebody else&apos;s live table.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;It serves riders and drivers.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;We are guests here.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="180" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;teach.bronze_trips&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Our copy. Same columns,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;same values, same names.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="880" height="152" as="geometry"/></mxCell><mxCell id="n6" value="one query, one window" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Why so strict?&lt;/b&gt;&lt;br&gt;&lt;br&gt;The moment bronze starts cleaning, renaming or joining, you can no longer answer one question: &lt;i&gt;is this wrong because the source sent it wrong, or because we broke it on the way in?&lt;/i&gt;&lt;br&gt;&lt;br&gt;Bronze exists so that question always has an answer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="1820" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="b2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A window, anchored on the data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="A pipeline never reads the whole table. It rebuilds a small window, over and over." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;WRONG: count back from today&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;today minus 7 days&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A dataset generated once and left alone&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;has nothing near today. You read zero&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;rows and lose twenty minutes.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="880" height="236" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;WRONG: max(date)&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;max(requested_at)&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;One stray test row dated next year&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;drags the anchor to a day holding&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;a single ride.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="880" height="236" as="geometry"/></mxCell><mxCell id="n6" value="SELECT&amp;nbsp;date(requested_at)&lt;br&gt;FROM&amp;nbsp;kerb.trips&lt;br&gt;GROUP&amp;nbsp;BY&amp;nbsp;1&lt;br&gt;HAVING&amp;nbsp;count(*)&amp;nbsp;&gt;&amp;nbsp;100&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--&amp;nbsp;a&amp;nbsp;real&amp;nbsp;day&amp;nbsp;of&amp;nbsp;trading&lt;br&gt;ORDER&amp;nbsp;BY&amp;nbsp;1&amp;nbsp;DESC&amp;nbsp;LIMIT&amp;nbsp;1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Courier New;fontSize=18;fontColor=#E2E8F0;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="880" height="190" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;lo is inclusive. hi is exclusive. Always.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mixing those up is how you get a pipeline that double counts one day, every single run, for months, while every total looks almost right." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="880" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="b3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A value you cannot read: three answers, two of them lies" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1410" height="46" as="geometry"/></mxCell><mxCell id="n3" value="This is the decision at the heart of every bronze pipeline." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1410" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;DROP IT&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The row count is quietly smaller.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Nobody ever finds out.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A lie.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;DEFAULT IT&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A number appears on a finance&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;report that never happened.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A worse lie.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;HOLD IT&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The warehouse is briefly&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;incomplete, and somebody&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;can see exactly why.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The only honest answer.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Held, not lost.&lt;/b&gt; Quarantine keeps the record, the reason, and the original payload, so the person who picks it up tomorrow has everything they need and does not have to guess. For a stream it keeps the partition and offset too, so you can go back to the exact message." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="1350" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>