<mxfile host="app" agent="nightshift"><diagram name="s1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2530" pageHeight="1740" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="NIGHTSHIFT, on one page" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="2350" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Sources at the top. The copy in the middle. Two services underneath. People at the bottom. Nothing reads upward." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="2350" height="34" as="geometry"/></mxCell><mxCell id="n4" value="1  SOURCES   ·   not ours to change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;kerb.trips&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;PostgreSQL&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;trips.lifecycle&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Kafka&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;driver_app_events&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;MongoDB&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;PayNimbus&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;a partner&apos;s REST API&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n9" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;regulator/&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;gzipped CSV in S3&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="234" width="410" height="124" as="geometry"/></mxCell><mxCell id="n10" value="2  INGEST   ·   copy it, and check it on the way in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;six pipelines&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;One per source, each with its own contract.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;What nobody can read goes to quarantine.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="534" width="1350" height="152" as="geometry"/></mxCell><mxCell id="n12" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;teach.quarantine&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Held, with the reason and payload.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;An inbox with an owner.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="534" width="880" height="152" as="geometry"/></mxCell><mxCell id="n13" value="3  THE WAREHOUSE   ·   the only thing the services ever read" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="750" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n14" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;bronze&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;landed untouched&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="834" width="410" height="124" as="geometry"/></mxCell><mxCell id="n15" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;silver&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one row per ride&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="834" width="410" height="124" as="geometry"/></mxCell><mxCell id="n16" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;gold&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;one row per day&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="834" width="410" height="124" as="geometry"/></mxCell><mxCell id="n17" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;teach.runs&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;did it run,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and finish&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="834" width="410" height="152" as="geometry"/></mxCell><mxCell id="n18" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;17 invariants&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;things that must&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;NEVER be false&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="834" width="410" height="152" as="geometry"/></mxCell><mxCell id="n19" value="4  TWO SERVICES   ·   this is what the project is about" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="1050" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n20" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;THE SIGNAL BOARD&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;13 KPIs on a clock. Groups before it pages.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;One record per cause, not per signal.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="1134" width="880" height="152" as="geometry"/></mxCell><mxCell id="n21" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;THE ON CALL AGENTS&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Asleep until a record arrives. Five specialists.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Diagnoses, proposes, verifies. Changes nothing.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="1134" width="880" height="152" as="geometry"/></mxCell><mxCell id="n22" value="one incident" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="5  PEOPLE   ·   every outcome is something a person decides on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#FFFFFF;fontStyle=1;align=left;spacing=22;" vertex="1" parent="1"><mxGeometry x="90" y="1350" width="2350" height="56" as="geometry"/></mxCell><mxCell id="n24" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;A CONFLUENCE PAGE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;diagnosis, evidence,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and a diagram&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="1434" width="410" height="152" as="geometry"/></mxCell><mxCell id="n25" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;A TICKET&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;with an owner&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;and a severity&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="1434" width="410" height="152" as="geometry"/></mxCell><mxCell id="n26" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;A PULL REQUEST&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;never merged,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;an allow list of four&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="1434" width="410" height="152" as="geometry"/></mxCell><mxCell id="n27" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;AN APPROVAL&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;for anything touching data.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The graph stops.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="1434" width="410" height="152" as="geometry"/></mxCell><mxCell id="n28" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#6B7280&apos;&gt;A HUMAN&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;decides.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Always.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F4F5;strokeColor=#D4D4D8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="1434" width="410" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="s2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="What happens when a number moves" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="2820" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Nobody types anything after the first line." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="2820" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;1  A FIELD MOVES&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A mobile release sends surge at a new path.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;2  NOTHING FAILS&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Every pipeline runs. Every row count is unchanged.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;3  THE CLOCK&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;60 seconds later, one of 13 KPIs is out of range.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;4  ONE RECORD&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Grouped with anything else that moved for the same reason.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;5  FIVE AGENTS&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Real, then what, then where from, then the fix, then proof.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1970" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n9" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;6  A PAGE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;With an owner, a diagram, the evidence and a diff.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="2440" y="150" width="410" height="152" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111111;strokeWidth=2.5;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=17;fontColor=#111111;labelBackgroundColor=#FFFFFF;spacing=8;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Step 2 is the whole problem.&lt;/b&gt; A pipeline that fails wakes somebody. A pipeline that succeeds while quietly carrying less data than it should wakes nobody, and every row count check you can write stays green through it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Step 6 is the whole point.&lt;/b&gt; Not a fix: a person arriving at a diagnosis three hours early, with the queries already run and the change written out." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="2760" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="s3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="What it cannot do, and why that is a fact rather than a promise" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Every boundary is enforced by a property of the system, not by a prompt." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;CANNOT WRITE TO THE WAREHOUSE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The connection is opened&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;read only, so Postgres itself&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;refuses the write.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Not a rule in a prompt.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;CANNOT EDIT ITS OWN TESTS&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Code changes are limited to&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;four directories.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;An agent that can edit the&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;tests judging it is not&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;being judged.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="264" as="geometry"/></mxCell><mxCell id="n6" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B45309&apos;&gt;CANNOT SHIP A CHANGE&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A branch and a pull request,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;in an isolated worktree.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Never a merge, never main,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;never your working tree.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n7" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;CANNOT TOUCH DATA&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The graph STOPS and waits&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;for a person.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;The tool would not run the&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;statement even if it ran.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1500" y="150" width="410" height="236" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Whether an agent meant well is a judgement. Whether it CAN write is a fact.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build on facts. Every rule you enforce only in a system prompt is a rule you are hoping about, and hope is not a security model. 191 tests hold these four boundaries in place, and none of them needs a database." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="1820" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>