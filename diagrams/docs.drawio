<mxfile host="app" agent="nightshift"><diagram name="d1"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="A document is not a row" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="The source is nested. The target is flat. Somebody has to decide which values become columns." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;event_id&quot;:&amp;nbsp;&quot;EVT0001&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;trip_id&quot;:&amp;nbsp;&amp;nbsp;&quot;TRP00281&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;app&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;&quot;version&quot;:&amp;nbsp;&quot;4.1.2&quot;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;payload&quot;:&amp;nbsp;{&amp;nbsp;&quot;surge_multiplier&quot;:&amp;nbsp;1.4,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;eta_s&quot;:&amp;nbsp;240&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;...&amp;nbsp;fourteen&amp;nbsp;more&amp;nbsp;fields&lt;br&gt;}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontFamily=Courier New;fontSize=18;fontColor=#E2E8F0;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="880" height="280" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#1D4ED8&apos;&gt;teach.bronze_driver_app&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;event_id, trip_id, driver_id,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;event_type, happened_at,&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;app_version, surge&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;Six columns, out of twenty fields.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="880" height="236" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Six of twenty, on purpose.&lt;/b&gt; Bronze copies what the business has agreed it needs, not everything that happens to exist. Landing every field of every document gives you a table nobody can read and a schema that changes under you every release." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="1820" height="122" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="d2"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="960" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="The failure this notebook is really about" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1880" height="46" as="geometry"/></mxCell><mxCell id="n3" value="A field moves. Nothing breaks. Nobody finds out for three weeks." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="1880" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#047857&apos;&gt;MONDAY&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;payload.surge_multiplier  1.4&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;the pricing team gets its number&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="880" height="158" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:22px;font-weight:600;color:#B91C1C&apos;&gt;TUESDAY, release 4.2&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;pricing.surge_multiplier  1.4&lt;/div&gt;&lt;div style=&apos;font-family:Courier New;font-size:17px;margin-top:7px&apos;&gt;payload.surge_multiplier  --&lt;/div&gt;&lt;div style=&apos;font-size:16px;color:#6B7280;margin-top:12px&apos;&gt;a perfectly reasonable refactor, and nobody told the data team&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="880" height="188" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Watch what does NOT happen.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The pipeline does not fail. It reads the document fine.&lt;br&gt;The rows still land. The count is unchanged.&lt;br&gt;Surge is just empty, on some rows, starting Tuesday.&lt;br&gt;&lt;br&gt;&lt;b&gt;Every row count check you can write stays green through that.&lt;/b&gt; Which is why the contract is a list of every path the value has ever legitimately lived at, and why a document matching none of them is held rather than defaulted to zero." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="1820" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="d3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="900" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Zero is not the same as unknown" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=34;fontColor=#111111;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="940" height="46" as="geometry"/></mxCell><mxCell id="n3" value="The one decision that separates a warehouse people trust from one they do not." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=21;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="90" y="96" width="940" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#047857&apos;&gt;surge = 0&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;There genuinely was no surge&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;on this ride.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A fact.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n5" value="&lt;div style=&apos;font-size:24px;font-weight:600;color:#B91C1C&apos;&gt;surge = 0&lt;/div&gt;&lt;div style=&apos;font-size:19px;color:#111111;line-height:1.45&apos;&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;We could not find the field.&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;A lie, and once written the two&lt;/div&gt;&lt;div style=&apos;margin-top:9px&apos;&gt;are indistinguishable.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="410" height="208" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Holding it costs you an incomplete table for a day.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Defaulting it costs you a wrong number forever, with nothing to point at.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Picture a report that averages surge. Every defaulted zero drags the average down and quietly misprices the product, and no check anywhere goes red." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#111111;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="480" width="880" height="182" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>